# 이 파일을 .env 로 복사해서 값을 채운다.
# .env 는 절대 공유하지 마라 (토큰이 들어간다).

# ── 텔레그램 (필수) ─────────────────────────────────────────────────
# 1. 텔레그램에서 @BotFather 검색 → /newbot → 이름 정하면 토큰을 준다
TELEGRAM_BOT_TOKEN=
# 2. 만든 봇에게 아무 말이나 보낸 뒤 `python main.py listen` 실행하고 /start
#    를 보내면 자동 등록된다. 직접 넣고 싶으면 @userinfobot 으로 내 ID 확인
TELEGRAM_CHAT_ID=

# ── 항공권 가격 (하나 이상 필요) ────────────────────────────────────
# travelpayouts.com 무료 가입 → Flight Data API 토큰. 이게 기본 스캐너다.
TRAVELPAYOUTS_TOKEN=
# (선택) developers.amadeus.com 무료 티어. 딜 후보만 실시간 재확인하는 용도.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOST=test.api.amadeus.com

# ── 검색 조건 ───────────────────────────────────────────────────────
ORIGIN=ICN
ORIGIN_CITY_KO=서울
CURRENCY=krw
SEARCH_START_DAYS=14
# 앞으로 몇 개월치를 볼지. 장거리는 반년 이상 앞서 특가가 풀린다.
# 늘릴수록 훑는 시간이 비례해서 늘어난다(8개월 ≈ 8분).
SEARCH_MONTHS=8

# 여행 기간 규칙
NEAR_MIN_DAYS=2
NEAR_MAX_DAYS=4
FAR_MIN_DAYS=7
FAR_MAX_DAYS=14
NEAR_FAR_KM=4500

# ── 딜 판정 ─────────────────────────────────────────────────────────
DEAL_DROP_PCT=25
JACKPOT_DROP_PCT=40
# 스카이스캐너 Drops 방식: 최근 7일 최저가보다 이만큼 더 싸면 딜.
# 위 기준과 둘 중 하나만 걸려도 알린다.
WEEK_LOW_DROP_PCT=20
WEEK_LOW_DAYS=7
MIN_WEATHER_SCORE=60
ALERT_COOLDOWN_HOURS=72
MAX_ALERTS_PER_SCAN=6

# ── 네이버 항공권 (가격그래프·추천일정 자료, 키 불필요) ─────────────
NAVER_ENABLED=1
NAVER_ORIGIN_CITY=SEL
# 같은 달 평소가보다 이만큼 싸면 딜
MONTH_DROP_PCT=30
# 이 경로는 거리별 일수 규칙(2~4일/7~14일)을 안 건다. 그 규칙 때문에
# 싼 값을 놓치고 있었다(도쿄 14일 182,235원 vs 2~4일 233,666원).
NAVER_MIN_DAYS=2
NAVER_MAX_DAYS=14
# 평소값을 말하려면 같은 무리가 최소 이만큼 모여야 한다
NAVER_MIN_PEERS=8
# 달 기준값이 노선 전 기간 중앙값의 이 배를 넘으면 표본이 얇은 것이라 버린다
NAVER_MAX_BASELINE_RATIO=1.6

# ── 여행사 자유여행 특가 ────────────────────────────────────────────
PACKAGE_ENABLED=1
PACKAGE_FIT_ONLY=1
PACKAGE_DROP_PCT=25
PACKAGE_JACKPOT_PCT=40
MAX_PACKAGE_ALERTS=4
PACKAGE_MIN_PEERS=5
PACKAGE_DELAY=1.2

# ── 스캔 시각 ───────────────────────────────────────────────────────
# 하루 정해진 시각에만 돈다. 쉼표로 여러 개.
#   10:30 = 여행사가 특가를 올린 직후 (하나투어 타임세일이 월 오전 10시)
#   22:30 = 항공사 프로모션이 걸린다는 화~수 새벽 직전, 아직 예약 가능한 시간
# `python main.py hours` 로 실제 데이터를 보고 다시 정하는 게 좋다.
SCAN_TIMES=10:30,22:30
# SCAN_TIMES 를 비우면 이 간격으로 돈다
SCAN_INTERVAL_HOURS=6
HTTP_TIMEOUT=30
